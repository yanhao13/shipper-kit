FROM node:22-bookworm-slim

# git + the gh CLI (official apt repo, per cli.github.com)
ARG KEY_URL=https://cli.github.com/packages/githubcli-archive-keyring.gpg
ARG REPO_URL=https://cli.github.com/packages
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl wget ca-certificates \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && KEYRING=/etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && wget -qO- "$KEY_URL" > "$KEYRING" \
 && chmod go+r "$KEYRING" \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=$KEYRING] $REPO_URL stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*

# Claude Code, baked in at build time — the image IS the version.
# Rebuild to update; never let it self-update mid-run.
RUN npm install -g @anthropic-ai/claude-code
ENV DISABLE_AUTOUPDATER=1

# Non-root matters: --dangerously-skip-permissions refuses to run as root,
# on purpose — root + no prompts has no recovery story.
USER node

RUN git config --global user.name "loop-agent" \
 && git config --global user.email "loop-agent@localhost" \
 && git config --global --add safe.directory /workspace

WORKDIR /workspace

# Build:  docker build -f Dockerfile.agent -t agent-box .
# Smoke:  docker run --rm agent-box claude --version
