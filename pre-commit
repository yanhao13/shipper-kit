#!/bin/sh
# Pre-commit gate. Fill in real commands for your stack.
# Cheapest checks first — abort on the first failure.
set -e

echo "gate 1/3: format/lint"
<FILL_IN: e.g. npx eslint . OR ruff check .>

echo "gate 2/3: typecheck"
<FILL_IN: e.g. npx tsc --noEmit OR pyright>

echo "gate 3/3: tests"
<FILL_IN: e.g. npx vitest run OR pytest -q>

echo "all gates green"
